<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9D0"
    tools:context=".DetailsActivity">

    <Button
        android:id="@+id/btnVolverRecetas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/volver_recetas"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#7B3F00" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvNombreDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#7B3F00"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Tacos de pollo" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/imgDetalleReceta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/foto_receta" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnFavorito"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_favorito"
                    android:padding="14dp"
                    android:src="@drawable/no_favorito"
                    android:contentDescription="@string/agregar_favorito" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEstadoFavorito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/agregar_favorito"
                android:textColor="#7B3F00"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/progresoDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvEstadoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/cargando_detalle"
                android:textSize="16sp"
                android:textColor="#3E2723" />

            <Button
                android:id="@+id/btnReintentarDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reintentar"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/contenidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvOrigenDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#7B3F00"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:text="@string/ingredientes"
                    android:textColor="#7B3F00"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIngredientesDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#3E2723"
                    android:textIsSelectable="true"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:accessibilityHeading="true"
                    android:text="@string/preparacion"
                    android:textColor="#7B3F00"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreparacionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5dp"
                    android:textColor="#3E2723"
                    android:textIsSelectable="true"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/fuente_recetas"
                    android:textColor="#5D4037"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
